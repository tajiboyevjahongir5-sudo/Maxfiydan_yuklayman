# ============================================================
#  TELEGRAM MEDIA BOT — Environment Variables (namuna)
#  Bu faylni nusxalab `.env` deb saqlang va qiymatlarni to'ldiring.
#  `.env` fayli hech qachon git'ga qo'shilmaydi (.gitignore'da).
# ============================================================

# --- Aiogram Bot ---
# @BotFather dan olinadigan bot token
BOT_TOKEN=123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Pyrogram Userbot ---
# https://my.telegram.org/apps dan olinadigan API ID va HASH
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef

# Majburiy emas: global userbot uchun session string (odatda bo'sh qoldiriladi,
# chunki har bir foydalanuvchi o'z akkauntini Web App orqali ulaydi).
# Olish uchun: python generate_session.py
PYROGRAM_SESSION_STRING=

# --- Xavfsizlik ---
# Admin panel JWT token'larini imzolash uchun kuchli maxfiy kalit (SHART!).
# Yaratish: python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_SECRET=

# Admin foydalanuvchi(lar) Telegram ID si (vergul bilan ajrating)
ADMIN_ID=123456789

# --- Ixtiyoriy sozlamalar ---
# Faqat ruxsat etilgan foydalanuvchilar (vergul bilan). Bo'sh = hammaga ruxsat.
ALLOWED_USERS=

# Vaqtinchalik fayllar papkasi
DOWNLOAD_DIR=./downloads

# Fayl yuklashda maksimal hajm (MB)
MAX_FILE_SIZE_MB=2000

# Ma'lumotlar bazasi (bo'sh = lokal SQLite). Railway Postgres avtomatik ulanadi.
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname

# Web App manzili (Railway'da RAILWAY_PUBLIC_DOMAIN avtomatik ishlatiladi)
# WEBAPP_URL=https://your-app.up.railway.app/user-dashboard
